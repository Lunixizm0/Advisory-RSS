# Advisory-RSS - copy to .env and fill GITHUB_TOKEN
# NEVER commit .env - it is gitignored. Do NOT put real tokens in this example file.

# GitHub PAT (least privilege)
# Fine-grained PAT (recommended): Repository security advisories: Read  + Metadata: Read
#   Create at: https://github.com/settings/personal-access-tokens/new
#   Expiry: short (30-90 days), rotate via `app auth login`.
# Classic PAT fallback: `repo` or at minimum `public_repo` (private drafts need `repo`)
# The token is NEVER logged or exposed via RSS/health.
GITHUB_TOKEN=ghp_your_token_here
# Alias accepted: GITHUB_PAT - but prefer GITHUB_TOKEN
# GITHUB_PAT=github_pat_your_token_here

# Optional: GitHub Enterprise / GHES base (default is https://api.github.com)
# GITHUB_API_BASE=https://api.github.com

# Server - MUST remain localhost-only. Do NOT change to 0.0.0.0 unless you fully redesign security.
BIND_ADDRESS=127.0.0.1
PORT=8765

# Background refresh interval in seconds (min 60). Zen Browser also polls RSS independently.
REFRESH_INTERVAL=600
# Max items in RSS feed (cache retains all to avoid missing advisories)
MAX_ITEMS=1000
# How to filter advisories: author (default) | author_or_publisher | author_or_collaborator
FILTER_MODE=author

# Optional: allow POST /refresh (default false - keep disabled to minimize attack surface)
# ENABLE_REFRESH_ENDPOINT=false
# REFRESH_TOKEN=change-me-to-random-uuid-if-enabled

# Logging
LOG_LEVEL=INFO
# LOG_FORMAT=text   # text | json (json gives structured logs for aggregation)
# LOG_FILE=cache/serve.log  # optional rotating file; if empty logs go to stderr (daemon still uses cache/serve.log)
# LOG_MAX_BYTES=5242880  # 5MiB per file (set via constant LOG_MAX_BYTES)
# LOG_BACKUP_COUNT=3

# Cache location (fixed, not user-controlled path traversal)
CACHE_PATH=cache/advisories.db

# Direct fetch - for advisories in repos you don't own (e.g. you authored GHSA in your-org/your-repo)
# Comma-separated list of repos to always scan (even if not in affiliation owner/member)
# Example: GITHUB_REPOS=your-org/your-repo,other-org/other-repo
# GITHUB_REPOS=
# GITHUB_ORG=your-org   # expands to all repos in org via /orgs/{org}/repos
# When true, skip scanning all owned repos and ONLY scan GITHUB_REPOS/GITHUB_ORG (fast, no full enumeration)
# SKIP_FULL_SCAN=false

# Hard caps to bound pagination (avoid silently hitting rate limits without warning)
# MAX_REPOS=1000
# MAX_PAGES_PER_REPO=100

# CERT-TR / Siber Güvenlik Başkanlığı via Proton Bridge or Gmail IMAP (never marks as read)
# When false (default) only GitHub source is active. RSS is mixed (GitHub + CERT-TR) when enabled.
# Works with both Proton Bridge (127.0.0.1) and Gmail (imap.gmail.com) simultaneously.
# ENABLE_CERT_TR=false
# For single account:
# PROTON_BRIDGE_EMAIL=mail@proton.me
# PROTON_BRIDGE_PASSWORD=your_bridge_generated_password   # Bridge -> Settings -> Mailbox details (NOT account password)
# PROTON_IMAP_FOLDER=INBOX                                  # Which folder/label to scan (INBOX, INBOX.CERT-TR, etc.)
# For multiple accounts (each mail + inbox separately configurable, never marks as read):
# PROTON_BRIDGE_EMAILS=mail@proton.me,second@proton.me
# PROTON_BRIDGE_PASSWORDS=bridge_pass1,bridge_pass2         # index-aligned with EMAILS
# PROTON_IMAP_FOLDERS=INBOX,INBOX.CERT-TR                    # index-aligned; missing -> defaults to PROTON_IMAP_FOLDER
# Bridge connection (usually don't change):
# PROTON_BRIDGE_HOST=127.0.0.1
# PROTON_IMAP_PORT=1143
# PROTON_IMAP_SECURITY=STARTTLS   # STARTTLS | SSL | NONE (Bridge uses STARTTLS, self-signed)
# Gmail alternative (same CERT-TR mails via Gmail IMAP, also never marks as read)
# GMAIL_EMAIL=your@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop   # Gmail App Password (16 chars, spaces preserved; for multi use comma)
# GMAIL_IMAP_FOLDER=INBOX
# For multiple Gmail accounts (each mail + inbox separately):
# GMAIL_EMAILS=your@gmail.com,second@gmail.com
# GMAIL_APP_PASSWORDS=app_pass1,"app pass 2 with spaces"   # comma-separated, spaces inside preserved
# GMAIL_IMAP_FOLDERS=INBOX,INBOX
# Gmail IMAP (usually don't change):
# GMAIL_IMAP_HOST=imap.gmail.com
# GMAIL_IMAP_PORT=993
# GMAIL_IMAP_SECURITY=SSL   # SSL for Gmail, STARTTLS for Proton Bridge

# Filtering & limits (applies to both Proton and Gmail):
# CERT_TR_SENDER_ALLOWLIST=siberguvenlik.gov.tr
# CERT_TR_MAX_MAILS=200
# CERT_TR_SEARCH_DAYS=   # empty = all time, or e.g. 30 for last 30 days
